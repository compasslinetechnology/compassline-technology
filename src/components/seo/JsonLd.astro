---
import { site } from '@/site.config';

interface ServiceSchema {
  serviceType: string;
  description: string;
  path: string;
}

interface Breadcrumb {
  name: string;
  path: string;
}

interface Props {
  service?: ServiceSchema;
  breadcrumbs?: Breadcrumb[];
}

const { service, breadcrumbs } = Astro.props;

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${site.url}/#organization`,
  name: site.name,
  url: site.url,
  description: site.description,
  email: site.email,
  slogan: site.tagline,
};

const serviceLd = service
  ? {
      '@context': 'https://schema.org',
      '@type': 'Service',
      serviceType: service.serviceType,
      description: service.description,
      url: new URL(service.path, site.url).toString(),
      provider: { '@id': `${site.url}/#organization` },
    }
  : null;

const breadcrumbLd =
  breadcrumbs && breadcrumbs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: breadcrumbs.map((crumb, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: crumb.name,
          item: new URL(crumb.path, site.url).toString(),
        })),
      }
    : null;
---

<script type="application/ld+json" set:html={JSON.stringify(organization)} />
{serviceLd && <script type="application/ld+json" set:html={JSON.stringify(serviceLd)} />}
{breadcrumbLd && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />}
