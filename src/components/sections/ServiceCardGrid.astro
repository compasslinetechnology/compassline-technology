---
export interface ServiceCard {
  icon: 'website' | 'workspace' | 'email' | 'dns' | 'hosting' | 'support';
  title: string;
  description: string;
  href: string;
  cta: string;
}

interface Props {
  services: ServiceCard[];
  heading?: string;
  subheading?: string;
}

const { services, heading, subheading } = Astro.props;

const icons: Record<ServiceCard['icon'], string> = {
  website: `<path d="M4 6a2 2 0 012-2h12a2 2 0 012 2v12a2 2 0 01-2 2H6a2 2 0 01-2-2V6z"/><path d="M4 9h16"/><path d="M8 13h5"/><path d="M8 16h3"/>`,
  workspace: `<rect x="4" y="4" width="7" height="7" rx="1"/><rect x="13" y="4" width="7" height="7" rx="1"/><rect x="4" y="13" width="7" height="7" rx="1"/><rect x="13" y="13" width="7" height="7" rx="1"/>`,
  email: `<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/>`,
  dns: `<circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17"/><path d="M12 3.5c2.5 2.4 3.8 5.2 3.8 8.5s-1.3 6.1-3.8 8.5c-2.5-2.4-3.8-5.2-3.8-8.5S9.5 5.9 12 3.5z"/>`,
  hosting: `<rect x="3" y="4" width="18" height="6" rx="1.5"/><rect x="3" y="14" width="18" height="6" rx="1.5"/><circle cx="7" cy="7" r="0.8" fill="currentColor" stroke="none"/><circle cx="7" cy="17" r="0.8" fill="currentColor" stroke="none"/>`,
  support: `<path d="M12 3a9 9 0 00-9 9v5a2 2 0 002 2h1a1 1 0 001-1v-5a1 1 0 00-1-1H5a7 7 0 0114 0h-1a1 1 0 00-1 1v5a1 1 0 001 1h1a2 2 0 002-2v-5a9 9 0 00-9-9z"/>`,
};
---

<section class="section bg-paper">
  <div class="container-content">
    {(heading || subheading) && (
      <div class="max-w-2xl mb-14 reveal">
        {heading && <h2 class="text-3xl md:text-4xl font-semibold">{heading}</h2>}
        {subheading && <p class="mt-4 text-lg text-ink/70 leading-relaxed">{subheading}</p>}
      </div>
    )}

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {services.map((service, i) => (
        <div class="card flex flex-col reveal" style={`transition-delay: ${(i % 3) * 70}ms`}>
          <div class="w-11 h-11 rounded-full bg-navy/5 flex items-center justify-center text-navy mb-5">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[service.icon]} />
          </div>
          <h3 class="text-lg font-semibold text-navy mb-2">{service.title}</h3>
          <p class="text-sm text-ink/70 leading-relaxed flex-1">{service.description}</p>
          <a href={service.href} class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-harbor hover:text-navy group">
            {service.cta}
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" class="transition-transform group-hover:translate-x-0.5"><path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
