---
import ServicePageLayout from '@/layouts/ServicePageLayout.astro';
import FeatureList from '@/components/sections/FeatureList.astro';

const features = [
  { title: 'Google Workspace Gmail', body: 'Professional email delivered through Gmail\u2019s familiar interface and mobile apps.' },
  { title: 'Custom Email Domains', body: 'Email addressed at your own domain instead of a free provider.' },
  { title: 'Email Aliases', body: 'Addresses like info@ or support@ that route to the right person or team.' },
  { title: 'Department Addresses', body: 'Shared addresses for sales, billing, or support that multiple people can monitor.' },
  { title: 'SPF', body: 'A DNS record that tells other mail servers which sources are allowed to send email for your domain.' },
  { title: 'DKIM', body: 'A cryptographic signature that helps receiving servers confirm your email wasn\u2019t altered in transit.' },
  { title: 'DMARC', body: 'A policy that tells receiving servers what to do with mail that fails SPF or DKIM checks.' },
  { title: 'Email Deliverability', body: 'Configuration aimed at keeping your legitimate email out of spam folders.' },
  { title: 'Account Security', body: 'Sensible password and access policies to keep business email accounts protected.' },
];
---

<ServicePageLayout
  title="Professional Business Email Setup"
  description="Compassline Technology sets up professional business email on your own domain, with SPF, DKIM, DMARC, and ongoing support."
  path="/business-email"
  pageLabel="Business Email"
  eyebrow="Business Email"
  heroHeading="Professional Business Email Setup"
  heroSubheading="Email on your own domain, configured for deliverability and security — not a free address that undersells your business."
  primaryCta={{ label: 'Improve My Business Email', href: '/contact?service=business-email' }}
  secondaryCta={{ label: 'Schedule a Consultation', href: '/contact?service=business-email' }}
  serviceType="Professional Business Email Setup"
  finalCtaHeading="Ready to email from your own domain?"
  finalCtaBody="We'll set it up, configure the security records, and make sure your mail actually gets delivered."
  related={[
    { title: 'Google Workspace', description: 'Business email is one part of a full Google Workspace setup.', href: '/google-workspace' },
    { title: 'Technology Services', description: 'The domain and DNS work that email authentication depends on.', href: '/technology-services' },
  ]}
>
  <section class="section bg-white border-t border-b border-mist">
    <div class="container-content">
      <div class="max-w-3xl mb-12">
        <h2 class="text-2xl md:text-3xl font-semibold mb-5">The address on your business card matters</h2>
        <p class="text-ink/70 leading-relaxed">
          There's a real difference between how these two addresses read to a potential customer:
        </p>
      </div>

      <div class="grid sm:grid-cols-2 gap-6 max-w-3xl">
        <div class="rounded-card border border-mist p-6 bg-paper">
          <p class="eyebrow mb-3" style="color:#8a8f8c">Free Address</p>
          <p class="font-mono text-lg text-ink/70">businessname@gmail.com</p>
          <p class="mt-3 text-sm text-ink/60 leading-relaxed">Works, but reads as a business still getting off the ground &mdash; and it isn't protected by your own domain's security settings.</p>
        </div>
        <div class="rounded-card border-2 border-brass p-6 bg-white">
          <p class="eyebrow mb-3">Professional Address</p>
          <p class="font-mono text-lg text-navy">you@businessname.com</p>
          <p class="mt-3 text-sm text-ink/70 leading-relaxed">Reinforces your brand every time you send an email, and gives you control over security, aliases, and who has access.</p>
        </div>
      </div>
    </div>
  </section>

  <FeatureList
    heading="What's included"
    subheading="A properly configured business email setup covers more than just an inbox."
    features={features}
  />
</ServicePageLayout>
