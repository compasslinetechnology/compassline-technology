---
import ServicePageLayout from '@/layouts/ServicePageLayout.astro';
import FeatureList from '@/components/sections/FeatureList.astro';

const features = [
  { title: 'Google Workspace Administration', body: 'Ongoing setup, configuration, and support for your Workspace environment.' },
  { title: 'Account & User Management', body: 'Adding, removing, and adjusting access as your team changes.' },
  { title: 'Domain Management', body: 'Registration assistance, renewals, and keeping domain settings organized.' },
  { title: 'DNS', body: 'Managing the records that control how your domain routes email, websites, and other services.' },
  { title: 'Cloudflare', body: 'Configuration for performance, security, and DNS management through Cloudflare.' },
  { title: 'Website Infrastructure', body: 'The hosting, DNS, and technical setup that keeps a website reliable.' },
  { title: 'Business Email', body: 'Setup and ongoing management of professional email on your domain.' },
  { title: 'Vendor Coordination', body: 'Acting as your technical point of contact with other vendors when needed.' },
  { title: 'Technology Consulting', body: 'Plain-English guidance on technology decisions as your business grows.' },
  { title: 'General Technical Troubleshooting', body: 'Practical help when something technology-related isn\u2019t working.' },
];
---

<ServicePageLayout
  title="Technology Services for Small Businesses"
  description="Compassline Technology provides Google Workspace administration, domain and DNS management, Cloudflare setup, and general technology support for small businesses."
  path="/technology-services"
  pageLabel="Technology Services"
  eyebrow="Technology Services"
  heroHeading="Technology Services for Small Businesses"
  heroSubheading="Practical technical expertise for businesses that need real help but don't need a full-time IT employee."
  primaryCta={{ label: 'Talk About My Technology', href: '/contact?service=technology-support' }}
  secondaryCta={{ label: 'Schedule a Consultation', href: '/contact?service=technology-support' }}
  serviceType="Small Business Technology Services"
  finalCtaHeading="Not sure exactly what you need?"
  finalCtaBody="That's a normal place to start. Tell us what's not working and we'll help you figure out the right next step."
  related={[
    { title: 'Google Workspace', description: 'A closer look at Workspace setup and administration specifically.', href: '/google-workspace' },
    { title: 'Website Management', description: 'Ongoing management for the website side of your technology.', href: '/website-management' },
  ]}
>
  <section class="section bg-white border-t border-b border-mist">
    <div class="container-content max-w-3xl">
      <h2 class="text-2xl md:text-3xl font-semibold mb-5">You don't need an IT department. You need a technology partner.</h2>
      <p class="text-ink/70 leading-relaxed">
        Most small businesses have real technology needs &mdash; email, domains, security, day-to-day
        troubleshooting &mdash; without the size to justify hiring for it. Compassline serves as that
        technical resource: available when something needs attention, and proactive about the things
        that tend to go wrong quietly, like an expiring domain or a misconfigured email record.
      </p>
    </div>
  </section>

  <FeatureList
    heading="Where we can help"
    features={features}
  />
</ServicePageLayout>
