---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found"
  description="The page you're looking for doesn't exist."
  path="/404"
>
  <section class="bg-navy min-h-[60vh] flex items-center">
    <div class="container-content py-24 text-center">
      <p class="eyebrow mb-5">404</p>
      <h1 class="text-4xl md:text-5xl font-semibold text-paper mb-5">This route doesn't lead anywhere</h1>
      <p class="text-paper/70 max-w-md mx-auto mb-9 leading-relaxed">
        The page you're looking for may have moved. Here are a few places to head instead.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a href="/" class="btn-primary">Back to Home</a>
        <a href="/contact" class="btn-secondary">Contact Us</a>
      </div>
    </div>
  </section>
</BaseLayout>
